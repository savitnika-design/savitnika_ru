# hashed scripts and styles never change, so browsers may keep them for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# videos, images and orca pictures: a week
/cases/*
  Cache-Control: public, max-age=604800
/orcas/*
  Cache-Control: public, max-age=604800
/thumbs/*
  Cache-Control: public, max-age=604800
/resume/*
  Cache-Control: public, max-age=604800
